# Backend Environment Variables for Production

# Server Configuration
PORT=8080
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chat_india

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long!

# CORS & Frontend
FRONTEND_URL=https://chat-india.vercel.app

# Demo-only: return OTP in response (do not enable for real production)
SHOW_OTP_IN_PROD=false

# Optional: Redis (remove if not using)
# REDIS_URL=redis://username:password@hostname:port

# Optional: Socket.IO Configuration
SOCKET_CORS_ORIGIN=https://chat-india.vercel.app
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000
